{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/optical-lift/atlas-ledger-foundry/spec/schema/case.schema.json",
  "title":"Foundry Adjudication Case v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["case_id","workspace_id","topic","status","origin_refs","opened_at"],
  "properties":{
    "case_id":{"type":"string","minLength":1},
    "workspace_id":{"type":"string","minLength":1},
    "topic":{"type":"string","minLength":1},
    "subject_ref":{"type":["string","null"]},
    "status":{"type":"string","enum":["OPEN","INTERPRETING","ADJUDICATING","CLOSED","SUPERSEDED"]},
    "origin_refs":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "question_ref":{"type":["string","null"]},
    "question_operator":{"type":["string","null"]},
    "finding_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "discrepancy_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "signal_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "competing_interpretations":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["interpretation_id","claim","basis_refs"],"properties":{"interpretation_id":{"type":"string"},"claim":{"type":"string"},"basis_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"conflicting_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"discriminator":{"type":["string","null"]}}}},
    "disposition_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "dependency_impact_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "structural_delta_ref":{"type":["string","null"]},
    "residual_issue_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "opened_at":{"type":"string","format":"date-time"},
    "closed_at":{"type":["string","null"],"format":"date-time"},
    "closure_basis_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "supersedes_case_id":{"type":["string","null"]}
  }
}