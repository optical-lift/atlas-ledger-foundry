{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/optical-lift/atlas-ledger-foundry/spec/schema/dependency-impact.schema.json",
  "title":"Foundry Dependency Impact v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["impact_id","workspace_id","case_id","changed_ref","dependent_ref","outcome","reason","evaluated_at"],
  "properties":{
    "impact_id":{"type":"string","minLength":1},
    "workspace_id":{"type":"string","minLength":1},
    "case_id":{"type":"string","minLength":1},
    "changed_ref":{"type":"string","minLength":1},
    "dependent_ref":{"type":"string","minLength":1},
    "outcome":{"type":"string","enum":["UNAFFECTED","RECHECK_REQUIRED","REOPEN","SUPERSEDE","BLOCKED_PENDING_PARENT"]},
    "reason":{"type":"string","minLength":1},
    "basis_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "independent_basis_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "blocking":{"type":"boolean","default":false},
    "evaluated_at":{"type":"string","format":"date-time"}
  }
}