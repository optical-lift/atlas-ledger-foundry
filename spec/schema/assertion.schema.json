{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/optical-lift/atlas-ledger-foundry/spec/schema/assertion.schema.json",
  "title": "Atlas Foundry Assertion Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assertion_id",
    "workspace_id",
    "assertion_kind",
    "stage",
    "subject_ref",
    "predicate",
    "created_at",
    "provenance"
  ],
  "properties": {
    "assertion_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "assertion_kind": {
      "type": "string",
      "enum": ["ENTITY", "RELATION", "EVENT", "STATE", "RULE", "AUTHORITY", "RESPONSIBILITY", "COMMITMENT", "BOUNDARY", "IDENTITY", "OTHER"]
    },
    "stage": {
      "type": "string",
      "enum": ["CANDIDATE", "NEEDS_CLARIFICATION", "ESTABLISHED", "CONFLICTED", "SUPERSEDED", "RETIRED", "REJECTED"]
    },
    "subject_ref": {"type": "string", "minLength": 1},
    "subject_label": {"type": ["string", "null"]},
    "predicate": {"type": "string", "minLength": 1},
    "object_ref": {"type": ["string", "null"]},
    "value": {},
    "context": {"type": ["string", "null"]},
    "effective_from": {"type": ["string", "null"]},
    "effective_until": {"type": ["string", "null"]},
    "as_of": {"type": ["string", "null"]},
    "modality": {
      "type": ["string", "null"],
      "enum": [null, "ACTUAL", "REQUIRED", "PERMITTED", "PROHIBITED", "POSSIBLE", "EXPECTED", "CONDITIONAL"]
    },
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "materiality": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"], "default": "MEDIUM"},
    "blocking": {"type": "boolean", "default": false},
    "inquiry": {"$ref": "inquiry-hint.schema.json"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_type", "basis_refs"],
      "properties": {
        "basis_type": {
          "type": "string",
          "enum": ["TESTIMONY", "SOURCE", "DERIVATION", "HUMAN_CONFIRMATION", "RECONCILIATION", "MIXED"]
        },
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "interpretation_note": {"type": ["string", "null"]}
      }
    },
    "supersedes_assertion_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
