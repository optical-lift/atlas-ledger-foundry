{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/optical-lift/atlas-ledger-foundry/spec/schema/testimony.schema.json",
  "title": "Atlas Foundry Testimony Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "testimony_id",
    "workspace_id",
    "source_kind",
    "captured_at",
    "content",
    "status"
  ],
  "properties": {
    "testimony_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "source_id": {"type": ["string", "null"]},
    "source_kind": {
      "type": "string",
      "enum": ["HUMAN_DIRECT", "DOCUMENT", "MESSAGE", "AI_HISTORY", "SOFTWARE_RECORD", "AUDIO", "IMAGE", "DATABASE", "OTHER"]
    },
    "speaker_or_origin": {"type": ["string", "null"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "effective_time": {"type": ["string", "null"]},
    "content": {"type": "string", "minLength": 1},
    "content_reference": {"type": ["string", "null"]},
    "context": {"type": ["string", "null"]},
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "SUPERSEDED", "WITHDRAWN", "DISPUTED"]
    },
    "supersedes_testimony_id": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
