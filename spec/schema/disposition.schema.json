{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/optical-lift/atlas-ledger-foundry/spec/schema/disposition.schema.json",
  "title":"Foundry Adjudication Disposition v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["disposition_id","workspace_id","case_id","type","reason_code","reason","basis_refs","affected_refs","authority","status","decided_at"],
  "properties":{
    "disposition_id":{"type":"string","minLength":1},
    "workspace_id":{"type":"string","minLength":1},
    "case_id":{"type":"string","minLength":1},
    "type":{"type":"string","enum":["CONFIRM","SUPERSEDE","CORRECT","SCOPE","TEMPORALIZE","CONDITIONALIZE","SPLIT","MERGE","OPEN_UNKNOWN","RESOLVE_UNKNOWN","PARTIALLY_RESOLVE","OPEN_CONTRADICTION","RESOLVE_CONTRADICTION","OPEN_SIGNAL","VALIDATE_SIGNAL","REFUTE_SIGNAL","REQUEST_MORE_EVIDENCE","ESCALATE","NO_CHANGE","REOPEN"]},
    "reason_code":{"type":"string","enum":["NEW_INFORMATION","SCOPE_CLARIFIED","TEMPORAL_CHANGE","IDENTITY_SPLIT","IDENTITY_MERGE","AUTHORITY_CLARIFIED","SOURCE_CORRECTED","EXCEPTION_DISCOVERED","RULE_NOT_CURRENT","DUPLICATE_REPRESENTATION","CONTRADICTED_BY_HIGHER_AUTHORITY","INSUFFICIENT_EVIDENCE","NON_MATERIAL_DIFFERENCE","ALREADY_REPRESENTED","DEPENDENCY_INVALIDATED","DEPENDENCY_NEEDS_REVIEW","USER_CORRECTION","NO_STRUCTURAL_EFFECT","OTHER"]},
    "reason":{"type":"string","minLength":1},
    "basis_refs":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "affected_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "authority":{"type":"string","enum":["AI_RECOMMENDATION","PRINCIPAL_CONFIRMATION","AUTHORITATIVE_SOURCE","GOVERNED_RECONCILIATION","SERVICE_RULE"]},
    "status":{"type":"string","enum":["PROPOSED","REQUIRES_CONFIRMATION","REQUIRES_ESCALATION","AUTHORIZED","APPLIED","REJECTED","SUPERSEDED"]},
    "resulting_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "decided_at":{"type":"string","format":"date-time"},
    "applied_at":{"type":["string","null"],"format":"date-time"}
  }
}